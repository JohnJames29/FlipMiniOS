<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#9FA7FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0A0C17</item>
        <item name="android:navigationBarColor">#0A0C17</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="CoverEngineTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">#9FA7FF</item>
    </style>
</resources>
