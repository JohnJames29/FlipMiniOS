<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="✦  FLIP MINI OS" android:letterSpacing="0.15"
        android:textSize="11sp" android:textStyle="bold" android:textColor="#C8EBFF" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="Everything you need."
        android:textSize="25sp" android:textStyle="bold" android:textColor="#FFFFFF" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="Right on your cover screen."
        android:textColor="#E3E8F5" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="28dp">
        <TextView android:id="@+id/open_launcher" android:layout_width="0dp"
            android:layout_height="54dp" android:layout_weight="1"
            android:gravity="center" android:background="@drawable/widget_button_primary"
            android:text="▦  Apps" android:textColor="#112037" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/open_panel" android:layout_width="0dp"
            android:layout_height="54dp" android:layout_weight="1"
            android:layout_marginStart="10dp" android:gravity="center"
            android:background="@drawable/widget_button_secondary"
            android:text="☷  Controls" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
